# Kedak Card frontend configuration (Vite). Copy to .env.local (or .env.development.local /
# .env.production.local) and adjust. Only VITE_* variables reach the browser: never put
# secrets here.

# Base URL of the Django API, including the version prefix. Required.
#   Development: the Django dev server
#   Production:  https://api.example.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Google Identity Services client ID (public). Must match GOOGLE_OAUTH_CLIENT_ID on the API,
# and this site's origin must be an authorised JavaScript origin in Google Cloud.
# Leave empty to show "Google sign-in isn't available" instead.
VITE_GOOGLE_CLIENT_ID=
