{
  "name": "kedak-bank-card",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" eslint.config.js prettier.config.js vite.config.ts env.d.ts index.html package.json tsconfig*.json",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" eslint.config.js prettier.config.js vite.config.ts env.d.ts index.html package.json tsconfig*.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript public/api-docs/openapi.json -o src/types/api/schema.d.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.3",
    "@primevue/forms": "^4.5.0",
    "@tanstack/vue-query": "^5.108.2",
    "axios": "^1.21.1",
    "libphonenumber-js": "^1.13.17",
    "pinia": "^2.3.0",
    "primeicons": "^8.0.2",
    "primevue": "^4.3.5",
    "vue": "^3.5.13",
    "vue-router": "^4.6.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.5",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^2.2.0"
  }
}
